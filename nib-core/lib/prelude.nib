// The default library for Nib

/// Abort immediately with an error value. The value will be converted to a string.
panic v = _prim_panic v

/// Exit with an exit code, the argument must be an integer. Only the lower 32 bits of the
/// argument will be used.
exit c = _prim_exit c

/// Load a Nib library
load p = _prim_load p false

/// Load a Nib library, even if it has been loaded before
reload p = _prim_load p true

/// Add two numbers
a + b = _prim_add a b

/// Subtract b from a
a - b = _prim_sub a b

/// Multiply two numbers
a * b = _prim_mul a b

/// Subtract n from zero
negate n = _prim_negate n

/// Divide a by b
a / b = _prim_div a b

/// Calculate `a` modulo `b`
mod a b = _prim_mod a b

/// Return `b` if `a` is greater than `b`, false otherwise
a > b = _prim_gt a b

/// Return `b` if `a` is greater than or equal to `b`, false otherwise
a >= b = _prim_gte a b

/// Return `b` if `a` is less than `b`, false otherwise
a < b = _prim_lt a b

/// Return `b` if `a` is less than or equal to `b`, false otherwise
a <= b = _prim_lte a b

/// Return true if `a` equals `b`, false otherwise
a == b = _prim_eq a b

/// Return true if `a` doesn't equal `b`, false otherwise
a != b = not (a == b)

not false = true
not _ = false

// bitops
bit_and a b = _prim_bitand a b
bit_or a b = _prim_bitor a b
bit_xor a b = _prim_bitxor a b
bit_not a = _prim_bitnot a
bit_shift a b = _prim_bitshift a b

// some arithmetic
max x y = x > y => x; y
min x y = x < y => x; y

// logic
x || y = x => x; y ()
x && y = x => y (); false

// convenience
on x f = f x
id x = x

begin ... last = last

/// Sequencing operator. The arguments are evaluated in order and the right argument
/// is returned.
a & b = b
const a b = a
apply f xs = _prim_apply f xs

// types


type v = _prim_type v

make_type type_sym name = new where
                                new = table.create ()
                                new.type_id = name
                                _ = table.set global type_sym new

type_name v = (type v).type_id
set_type v t = _prim_type_set v t

// IO
print a = _prim_string_print (_prim_to_string a)
println a =  print a & print "\n"

// Stuff that need prims
// =====================
// apply
// +, -, *, /, mod (at least type specific ones, maybe can do generic as lib)
// <, >, <=, >=, == - check
// sin, cos, tan, asin, acos, atan
// and, or, xor, lsh, rsh, (bit logic)
// type, set_type
// array (ref, set, new, size) - check
// bytearray (ref, set, new, size, 8-64bit ops signed unsigned) 
// symbol (new, new_well_known)
// table (create, ref, set, size)
// char (ord, chr, char array from/to bytes)
// ptr (peek, poke, offset) -- can wait
// IO (print, println, put_char, get_char. stdin. stderr, stdout, filehandling(file_open, file_close)) 
// Debug
//
// Stuff that doesn't need primitives
// ==================================
//
//
//

// Table functions
table.set tab key value = _prim_table_set value key tab
table.size t = _prim_table_size t
table.keys t = _prim_table_keys t
table.create _ = _prim_table_create ()

// Array functions
array.ref arr pos = _prim_array_ref pos arr 
array.set arr pos val = _prim_array_set val pos arr
array.size arr = _prim_array_size arr
array.create size = _prim_array_create size
array.for_each f arr = iter 0 where
                            len = array.size arr
                            iter n | n == len = ()
                            iter n = f n (array.ref arr n) & iter (n+1)

array.map f arr = out where
                        len = array.size arr
                        out = array.create len
                        go n | n == len = ()
                        go n = array.set out n (f (array.ref arr n)) & go (n+1)
                        _ = go 0

array.concat x y = merged where
                        xs = array.size x
                        ys = array.size y
                        cs = xs + ys
                        merged = array.create cs
                        go n | n == cs = ()
                        go n | n < xs = go (n + 1) where _ = array.set merged n (array.ref x n)
                        go n = go (n + 1) where _ = array.set merged n (array.ref y (n - xs))
                        _ = go 0

array.match v | type v == array = v
array.match _ = false

bytes.create sz = _prim_bytes_create sz
bytes.ref arr pos = _prim_bytes_ref pos arr
bytes.set arr pos val = _prim_bytes_set val pos arr
bytes.size b = _prim_bytes_size b
bytes.copy to from to_start from_start size = 
        go 0 where
            go n | n == size = () 
            go n = bytes.set to (to_start + n) (bytes.ref from (from_start+n))

bytes.concat x y = merged where
                        xs = bytes.size x
                        ys = bytes.size y
                        cs = xs + ys
                        merged = bytes.create cs 0
                        _ = bytes.copy merged x 0 0 xs
                        _ = bytes.copy merged y xs 0 ys

string.create sz = _prim_bytes_create (sz+1)
string.ref = bytes.ref
string.set = bytes.set
string.size str = _prim_bytes_size str - 1
string.concat x y = merged where
                        xs = string.size x
                        ys = string.size y
                        cs = xs + ys
                        merged = string.create cs 0
                        _ = bytes.copy merged x 0 0 xs
                        _ = bytes.copy merged y xs 0 ys 
string.substring = _prim_string_substring

to_string v = _prim_to_string v

a ++ b = (type a).concat a b

ffi.int8 = #cint8
ffi.int16 = #cint16
ffi.int32 = #cint32
ffi.int64 = #cint64

ffi.uint8 = #cuint8
ffi.uint16 = #cuint16
ffi.uint32 = #cuint32
ffi.uint64 = #cuint64

ffi.float32 = #cfloat
ffi.float64 = #cdouble

ffi.void = #cvoid
ffi.ptr = #cpointer 

ffi.pointer x = [#cpointer, x]
ffi.struct ...x = array.concat (array.make #cstruct) x

